# ==========================================
# Smart Medicine Platform — Environment Template
# ==========================================
# COPY THIS FILE TO .env OR .env.local IN YOUR MODULE
# NEVER COMMIT ACTUAL SECRETS TO GIT

# Backend / Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/smart_medicine_db
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Endpoints
API_BASE_URL=http://localhost:8000
LAYOUT_ENGINE_URL=http://localhost:8001
WEB_PANEL_URL=http://localhost:3000

# Voice Assistant / AI Services
LLM_API_KEY=
TTS_STT_PROVIDER_KEY=

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
